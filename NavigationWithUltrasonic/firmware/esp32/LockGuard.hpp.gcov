        -:    5:/**
        -:    6: * @brief RAII mutex lock helper.
        -:    7: *
        -:    8: * Locks the mutex on construction and automatically
        -:    9: * unlocks it when leaving scope.
        -:   10: *
        -:   11: * Usage:
        -:   12: *   LockGuard guard(mutex());
        -:   13: */
        -:   14:// Prevents forgotten unlocks.
        -:   15:class LockGuard
        -:   16:{
        -:   17:public:
    #####:   18:    explicit LockGuard(IMutex &mutex)
    #####:   19:        : m_mutex(mutex)
    #####:   20:    {
    #####:   21:        m_mutex.lock();
    #####:   22:    }
        -:   23:
    #####:   24:    ~LockGuard()
    #####:   25:    {
    #####:   26:        m_mutex.unlock();
    #####:   27:    }
        -:   28:
        -:   29:    LockGuard(const LockGuard &) = delete;
